# Neon Postgres connection string. Schema is created/migrated automatically
# on first request - no separate migration step.
DATABASE_URL=

# Web Push VAPID key pair - generate with `npx web-push generate-vapid-keys`.
# Push notifications are hidden in the UI entirely if these aren't set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the operator-only /api/admin/stats endpoint.
ADMIN_SECRET=

# Shared secret the scheduler sends when calling /api/cron/daily-reminder.
CRON_SECRET=
